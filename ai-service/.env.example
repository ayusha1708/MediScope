# Copy this file to .env and replace the MongoDB placeholders.
MONGODB_URI=mongodb+srv://<database-user>:<URL-encoded-password>@<cluster-host>/?retryWrites=true&w=majority&appName=MediScope
MONGODB_DB_NAME=medscope

# Local Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Generate a private value locally; never commit or share the real secret.
MEDISCOPE_SESSION_SECRET=replace-with-a-random-secret
